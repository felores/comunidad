# Hotmart (curso payments provider) - login propio + verificacion por email.
# OAuth client-credentials del merchant (no "sign in with Hotmart").
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=

# Clave para firmar cookies de sesion del piloto.
SESSION_SECRET=

# Runtime publico de Astro y Better Auth. Los valores reales viven fuera del repo.
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:4321
BETTER_AUTH_URL=http://localhost:4321
BETTER_AUTH_SECRET=<GENERATE_AT_LEAST_32_RANDOM_CHARACTERS>
AUTH_DATABASE_URL=postgresql://sp_auth:<LOCAL_PASSWORD>@127.0.0.1:54329/sp_auth

# En desarrollo, file escribe mensajes solo en .local-email/.
# Produccion exige resend y una direccion de un dominio verificado.
EMAIL_TRANSPORT=file
EMAIL_FILE_DIR=.local-email
RESEND_API_KEY=
EMAIL_FROM=Sociedad Paralela <cuentas@correo.sociedadparalela.com>

# Control plane. local solo funciona fuera de produccion.
CONTROL_PLANE_MODE=local
CONTROL_PLANE_BASE_URL=https://aos.markenetica.com
CONTROL_PLANE_TOKEN=
CONTROL_PLANE_TIMEOUT_MS=2500

# Remark42 local usa el proxy same-origin de Astro bajo /comentarios.
REMARK42_URL=http://localhost:4321/comentarios
REMARK42_INTERNAL_URL=http://127.0.0.1:8080
REMARK42_SITE_ID=sociedad-paralela
REMARK42_PROVIDER_NAME=sociedad-paralela
REMARK42_SECRET=
REMARK42_PROXY_TIMEOUT_MS=5000
REMARK42_OAUTH_CLIENT_ID=
REMARK42_OAUTH_CLIENT_SECRET=
# Solo durante el gate humano de provisioning. No persistir el cookie.
REMARK42_OAUTH_PROVISIONER_USER_ID=
REMARK42_OAUTH_PROVISIONER_SESSION_COOKIE=
REMARK42_OAUTH_SECRET_FIFO=/run/sp-oauth-handoff/client-secret.pipe
REMARK42_OAUTH_RESULT_FIFO=/run/sp-oauth-handoff/result.pipe
HANDOFF_ID=
HANDOFF_DEADLINE_EPOCH=
HANDOFF_SHARED_GID=10000

# Job consumidor aislado. El token vive solo en el secret store del runtime.
COOLIFY_API_BASE_URL=https://<COOLIFY_MANAGEMENT_FQDN>/api/v1
COOLIFY_SERVICE_ID=
COOLIFY_APPROVED_API_BASE_URL=https://<COOLIFY_MANAGEMENT_FQDN>/api/v1
COOLIFY_APPROVED_SERVICE_ID=
COOLIFY_API_TOKEN=
