{
  "name": "sociedad-paralela-comunidad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run build:ops",
    "build:ops": "node scripts/build-ops.mjs",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:behavior": "vitest run tests/behavior",
    "test:remark42-integration": "tsx scripts/check-remark42-integration.mjs",
    "test:oauth-handoff-runtime": "node scripts/check-oauth-handoff-runtime.mjs",
    "test:oauth-provisioning-integration": "tsx scripts/check-oauth-provisioning-integration.mjs",
    "test:e2e": "tsx scripts/run-e2e.mjs",
    "check:browser-output": "node scripts/check-browser-output.mjs",
    "check:containers": "docker compose -f compose.local.yml config --quiet",
    "gate": "npm run check && npm run build && npm run check:browser-output && npm run check:containers && npm run test:remark42-integration && npm run test:e2e",
    "auth:migrate": "tsx scripts/auth-migrate.mjs",
    "auth:remark42-client": "tsx scripts/provision-remark42-oauth-client.mjs",
    "db:up": "docker compose -f compose.local.yml up -d auth-db",
    "db:down": "docker compose -f compose.local.yml down -v",
    "check:platform-gates": "node cursos/cerebro-artificial/entitlement/gate-audit.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.1",
    "@astrojs/node": "11.1.6",
    "@better-auth/oauth-provider": "1.7.5",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/dotgothic16": "5.3.0",
    "astro": "7.3.3",
    "better-auth": "1.7.5",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "resend": "6.28.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.1",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
