---
import "@fontsource-variable/geist";
import "../styles/landing.css";
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Comunidad gratuita para construir infraestructura tecnológica propia en el mundo hispanohablante." />
    <title>Sociedad Paralela</title>
  </head>
  <body>
    <div class="lp-shell">
      <nav class="lp-nav" aria-label="Navegación principal">
        <a class="lp-brand" href="/">Sociedad Paralela</a>
        <a class="lp-nav__link" href="/posts">Publicaciones</a>
        <a class="lp-nav__link" href="/ingresar">Ingresar</a>
        <a class="lp-nav__action" href="/registro">Crear cuenta</a>
      </nav>
      <main class="lp-hero">
        <section class="lp-copy" aria-labelledby="titulo-principal">
          <p class="lp-meta">Sistema independiente / Comunidad 001</p>
          <h1 id="titulo-principal" class="lp-title">Tu lugar en Sociedad Paralela.</h1>
          <p class="lp-lede">Una comunidad gratuita para construir infraestructura propia, compartir implementaciones y aprender sin depender de una sola plataforma.</p>
          <div class="lp-actions">
            <a class="lp-button lp-button--primary" href="/registro">Abrir cuenta gratis</a>
            <a class="lp-button" href="/posts">Leer publicaciones</a>
          </div>
        </section>
        <div class="lp-art" aria-hidden="true">
          <span class="lp-art__line"></span>
          <span class="lp-art__label">Contexto propio / Acceso libre</span>
        </div>
      </main>
    </div>
  </body>
</html>
