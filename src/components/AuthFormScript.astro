---
interface Props {
  formId: string;
  endpoint: string;
  successPath: string;
  genericMessage?: string;
}

const { formId, endpoint, successPath, genericMessage } = Astro.props;
---
<script
  is:inline
  data-auth-form
  data-form-id={formId}
  data-endpoint={endpoint}
  data-success-path={successPath}
  data-generic-message={genericMessage ?? ""}
>
  const config = document.currentScript.dataset;
  const form = document.getElementById(config.formId);
  const status = form?.querySelector("[data-form-status]");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector("button[type=submit]");
    const data = Object.fromEntries(new FormData(form).entries());
    button.disabled = true;
    status.dataset.state = "pending";
    status.textContent = "Procesando...";

    try {
      const response = await fetch(config.endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) {
        const message = payload?.message === "Email not verified"
          ? "Debes verificar tu email antes de entrar."
          : "No pudimos completar la solicitud. Revisa los datos e inténtalo de nuevo.";
        throw new Error(message);
      }
      if (config.genericMessage) sessionStorage.setItem("sp_notice", config.genericMessage);
      window.location.assign(config.successPath);
    } catch (error) {
      status.dataset.state = "error";
      status.textContent = error instanceof Error ? error.message : "No pudimos completar la solicitud.";
      button.disabled = false;
      status.focus();
    }
  });
</script>
